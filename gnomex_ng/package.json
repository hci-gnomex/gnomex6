{
  "name": "gnomex-ng",
  "description": "The Gnomex Ng application",
  "repository": "https://github.com/hci-gnomex/gnomex.git",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve -c developmentTomcat --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:dev:tomcat": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build -c developmentTomcat --source-map=true",
    "build:prod:tomcat": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build -c productionTomcat --source-map=false",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "clean:dist": "rimraf dist",
    "clean": "npm cache clean --force && rimraf node_modules dist package-lock.json"
  },
  "dependencies": {
    "@angular/animations": "^9.1.13",
    "@angular/cdk": "8.2.3",
    "@angular/common": "^9.1.13",
    "@angular/compiler": "^9.1.13",
    "@angular/core": "^9.1.13",
    "@angular/forms": "^9.1.13",
    "@angular/material": "8.2.3",
    "@angular/material-moment-adapter": "8.2.3",
    "@angular/platform-browser": "^9.1.13",
    "@angular/platform-browser-dynamic": "^9.1.13",
    "@angular/platform-server": "^9.1.13",
    "@angular/router": "^9.1.13",
    "@angularclass/conventions-loader": "^1.0.2",
    "@angularclass/hmr": "^2.1.3",
    "@angularclass/hmr-loader": "~3.0.4",
    "@auth0/angular-jwt": "2.1.x",
    "@circlon/angular-tree-component": "^9.0.1",
    "@kolkov/angular-editor": "^1.2.0",
    "ag-grid-angular": "^21.2.2",
    "ag-grid-community": "^21.2.2",
    "ajv": "^6.4.0",
    "angular-2-local-storage": "^2.0.0",
    "angular-split": "^3.0.0",
    "angular2-cookie": "1.2.6",
    "angular2-cool-storage": "3.1.6",
    "angular2-jwt": "^0.2.3",
    "chart.js": "^2.8.0",
    "core-js": "^2.6.11",
    "file-saver": "^2.0.0",
    "font-awesome": "^4.7.0",
    "hammerjs": "^2.0.8",
    "html2canvas": "^1.4.1",
    "jquery": "^3.2.1",
    "jshint": "^2.9.5",
    "jspdf": ">=2.3.1",
    "mobx": "5.14.2",
    "moment": "2.24.0",
    "ng-dynamic-component": "5.0.0",
    "ng2-charts": "^2.4.2",
    "ng2-img-max": "^2.1.15",
    "popper.js": "^1.14.5",
    "properties-reader": "^2.1.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^6.5.5",
    "tslib": "^1.10.0",
    "zone.js": "~0.10.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.901.15",
    "@angular/cli": "^9.1.15",
    "@angular/compiler-cli": "^9.1.13",
    "@angular/language-service": "^9.1.13",
    "@types/chart.js": "^2.7.53",
    "@types/file-saver": "^2.0.0",
    "@types/hammerjs": "^2.0.33",
    "@types/html2canvas": "0.5.32",
    "@types/jasmine": "^3.5.0",
    "@types/jquery": "^3.3.31",
    "@types/lodash": "4.14.160",
    "@types/node": "^12.11.1",
    "@types/selenium-webdriver": "~3.0.13",
    "codelyzer": "^5.1.2",
    "gulp": "^4.0.2",
    "gulp-util": "^3.0.7",
    "jasmine-core": "^3.6.0",
    "karma": "^4.3.0",
    "karma-chrome-launcher": "^3.1.0",
    "karma-coverage-istanbul-reporter": "^2.1.1",
    "karma-jasmine": "^2.0.1",
    "karma-jasmine-html-reporter": "^1.4.2",
    "protractor": "^5.4.4",
    "rimraf": "^3.0.2",
    "ts-node": "^8.3.0",
    "tslint": "^5.20.1",
    "typescript": "^3.8.3"
  }
}
