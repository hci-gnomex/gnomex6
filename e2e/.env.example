# Copy to .env (git-ignored) and fill in. Never commit real passwords.

# Root of the GNomEx app, with trailing /gnomex/
#   Tomcat:    http://localhost:8080/gnomex/
#   ng serve:  http://localhost:4200/gnomex/
GNOMEX_BASE_URL=http://localhost:8080/gnomex/

# Optional test account that does NOT go through Duo: an external (non u-number)
# user, or a u-number listed in the server's duoExceptions. It should be able to
# see at least one experiment, analysis and data track. Leave blank to run the
# browse tests as a guest (public data). Don't use a real person's account.
GNOMEX_USER=
GNOMEX_PASSWORD=

# Optional: force a browser (msedge, chrome, chromium). By default Playwright's
# Chromium is used if downloaded, otherwise Edge on Windows / Chrome elsewhere.
# PW_CHANNEL=msedge
